{
    "name": "mj-zana/maker",
    "description": "Code generators for Zana modules, features, entities and controllers",
    "type": "library",
    "keywords": [
        "zana",
        "maker",
        "generator",
        "scaffolding",
        "modules"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/console": "^2.7",
        "mj-zana/core": "^2.11"
    },
    "require-dev": {
        "mj-zana/cache": "^2.2",
        "mj-zana/database": "^2.2",
        "mj-zana/ddd": "^2.0",
        "mj-zana/http": "^2.0",
        "mj-zana/mediator": "^2.0",
        "mj-zana/routing": "^2.0",
        "mj-zana/security": "^2.2",
        "mj-zana/serialization": "^2.7",
        "mj-zana/session": "^2.2",
        "mj-zana/testing": "^2.7",
        "mj-zana/translation": "^2.2",
        "mj-zana/validation": "^2.7",
        "mj-zana/view": "^2.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Maker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Maker\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../zana-container",
            "options": {
                "symlink": true,
                "versions": {
                    "mj-zana/container": "2.11.0"
                }
            }
        },
