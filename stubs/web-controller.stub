<?php

declare(strict_types=1);

namespace {{ namespace }};

{{ routingImports }}use Zana\Routing\Attribute\Route;
{{ securityImports }}use Zana\View\View;

#[Route('/{{ path }}'{{ routeMiddleware }})]
{{ access }}final class {{ name }}Controller
{
    #[Route('', methods: ['GET'], name: '{{ route }}.index')]
    public function index(): View
    {
        return View::make('@{{ module }}/{{ path }}/index', ['title' => '{{ name }}']);
    }
}
