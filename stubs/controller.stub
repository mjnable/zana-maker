<?php

declare(strict_types=1);

namespace {{ namespace }};

{{ routingImports }}use Zana\Routing\Attribute\Route;
{{ securityImports }}
#[Route('/api/{{ path }}'{{ routeMiddleware }})]
{{ access }}final class {{ name }}Controller
{
    /**
     * @return array<string, mixed>
     */
    #[Route('', methods: ['GET'], name: '{{ route }}.index')]
    public function index(): array
    {
        return ['data' => []];
    }

    /**
     * @return array<string, mixed>
     */
    #[Route('/{id}', methods: ['GET'], name: '{{ route }}.show')]
    public function show(string $id): array
    {
        return ['data' => ['id' => $id]];
    }
}
